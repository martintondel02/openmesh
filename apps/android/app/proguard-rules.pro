# OpenMesh release rules. Keep kotlinx.serialization generated serializers and the
# companion CBOR codec (it uses reflection only for @Serializable DTOs in this app).
-keepattributes *Annotation*, InnerClasses
-dontnote kotlinx.serialization.**
-keepclassmembers class **$$serializer { *; }
-keepclasseswithmembers class * {
    kotlinx.serialization.KSerializer serializer(...);
}
-keep,allowobfuscation @kotlinx.serialization.Serializable class org.openmesh.android.**

# UniFFI-generated bindings load libopenmesh_ffi.so through JNA (reflection + native calls).
-keep class uniffi.** { *; }
-keep class com.sun.jna.** { *; }
-keepclassmembers class * extends com.sun.jna.** { *; }
-dontwarn com.sun.jna.**
-dontwarn java.lang.ref.Cleaner
-dontwarn java.lang.ref.Cleaner$Cleanable

# Engine adapter and domain models are accessed directly by Compose/state flows.
-keep class org.openmesh.android.data.engine.** { *; }
-keep class org.openmesh.android.data.model.** { *; }

# Room entities/DAO are generated by KSP; keep the schema metadata.
-keep class org.openmesh.android.data.db.** { *; }
