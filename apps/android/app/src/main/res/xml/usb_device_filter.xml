<?xml version="1.0" encoding="utf-8"?>
<!--
  Match common USB-serial bridges used by OpenMesh radios (CP210x, CH340, FTDI, CDC-ACM).
  The app still probes the device with usb-serial-for-android and shows a clear error when
  no driver matches.
-->
<resources>
    <usb-device vendor-id="4292" />   <!-- 0x10C4 Silicon Labs CP210x -->
    <usb-device vendor-id="6790" />   <!-- 0x1A86 QinHeng CH340/CH341 -->
    <usb-device vendor-id="1027" />   <!-- 0x0403 FTDI -->
    <usb-device vendor-id="11914" />  <!-- 0x2E8A Raspberry Pi (Pico CDC) -->
    <usb-device vendor-id="3368" />   <!-- 0x0D28 NXP (mbed/CDC demos) -->
    <usb-device vendor-id="9114" />   <!-- 0x239A Adafruit (nRF52 dev boards) -->
    <usb-device vendor-id="12346" />  <!-- 0x303A Espressif (ESP32-S3 USB CDC) -->
</resources>
