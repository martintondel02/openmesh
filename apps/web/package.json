{
  "name": "@openmesh/web",
  "private": true,
  "version": "0.7.1",
  "type": "module",
  "description": "OpenMesh web/PWA client \u2014 chat, map and nodes for a LoRa mesh",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:image-wasm": "bash ../../crates/openmesh-image-wasm/build-wasm.sh",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "tauri": "tauri",
    "predev": "node scripts/copy-help.mjs && node scripts/build-image-wasm.mjs",
    "prebuild": "node scripts/copy-help.mjs && node scripts/build-image-wasm.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "1.79.0",
    "maplibre-gl": "^6.19.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.0",
    "vite": "^6.4.6",
    "vitest": "^5.1.1",
    "@tailwindcss/vite": "^4.3.5"
  }
}
