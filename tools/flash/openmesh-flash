def list_boards(as_json: bool) -> None:
    devices = enumerate_usb()
    if as_json:
        print(
            json.dumps(
                {
                    "boards": [
                        {
                            "key": b.key,
                            "name": b.name,
                            "flash": b.flash,
                            "artifact": b.artifact,
                            "role": b.role,
                            "notes": b.notes,
                        }
                        for b in BOARDS.values()
                    ],
                    "usb_devices": [
                        {
                            "vid": f"0x{d.vid:04x}",
                            "pid": f"0x{d.pid:04x}",
                            "product": d.product,
                            "serial": d.serial,
                            "tty": d.tty,
                        }
                        for d in devices
                    ],
                },
                indent=2,
            )
        )
        return
    print("Supported boards:\n")
    for board in BOARDS.values():
        print(f"  {board.key:16s} {board.name}")
        print(f"  {'':16s} role={board.role:16s} flash={board.flash:8s} artifact={board.artifact}")
        if board.uf2_labels:
            print(f"  {'':16s} UF2 drive labels: {', '.join(board.uf2_labels)}")
        if board.usb_vid_pid:
            ids = ", ".join(f"{v:04x}:{p:04x}" for v, p in board.usb_vid_pid)
            print(f"  {'':16s} USB VID:PID: {ids}")
        print()
    if devices:
        print("USB devices currently attached:\n")
        for device in devices:
            board = board_for_usb(device)
            board_name = board.key if board else "unknown"
            print(
                f"  {device.vid:04x}:{device.pid:04x}  {device.product or '(no product string)':40s}"
                f" {('-> ' + board_name) if board else ''}"
            )
            if device.tty:
                print(f"              tty: {device.tty}")
    else:
        print("No USB devices detected (is the board connected?).")
    mounts = [b for b in BOARDS.values() if b.flash == "uf2"]
    for board in mounts:
        mount = find_uf2_mount(board.uf2_labels)
        if mount:
            print(f"\nUF2 bootloader drive for {board.key}: {mount}")
    print("\nRun `openmesh-flash --board auto --dry-run` to see the flashing plan.")


def resolve_board(name: str) -> Board:
    key = name.strip().lower()
    key = ALIASES.get(key, key)
    if key == "auto":
        return detect_board()
    if key not in BOARDS:
        raise FlashError(
            f"unknown board '{name}'. Supported: {', '.join(BOARDS)} (or 'auto')", 2
        )
    return BOARDS[key]


def detect_board() -> Board:
    # 1) A UF2 bootloader drive is the strongest signal (nRF52 boards).
    for board in BOARDS.values():
        if board.flash == "uf2" and find_uf2_mount(board.uf2_labels) is not None:
            print(f"  detected UF2 bootloader drive for {board.key}")
            return board
    # 2) USB VID/PID match.
    matches: List[Board] = []
    for device in enumerate_usb():
        board = board_for_usb(device)
        if board is not None and board not in matches:
            matches.append(board)
    if len(matches) == 1:
        print(f"  detected {matches[0].key} by USB id")
        return matches[0]
    if len(matches) > 1:
        keys = ", ".join(b.key for b in matches)
        raise FlashError(
            f"several boards are attached ({keys}); pass --board <key> instead.", 3
        )
    raise FlashError(
        "could not auto-detect a board.\n"
        "  * nRF52 boards: enter the UF2 bootloader (double reset) so a drive appears.\n"
        "  * ESP32 boards: connect USB; `--list` shows what was detected.\n"
        "  * Or pass --board t1000e|rak4631_solar|seeed_solar|heltec_tracker.",
        3,
    )


def parse_args(argv: Optional[List[str]] = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="openmesh-flash",
        description="Flash OpenMesh firmware to supported LoRa boards (UF2 copy or esptool).",
        epilog="Run `openmesh-flash --list` to see supported boards and attached USB devices.",
    )
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    parser.add_argument("--list", action="store_true", help="list supported boards and USB devices")
    parser.add_argument("--list-json", action="store_true", help="machine-readable --list output")
    parser.add_argument(
        "--board",
        default=None,
        help="board key (t1000e, rak4631_solar, seeed_solar, heltec_tracker) or 'auto'",
    )
    parser.add_argument("--port", help="serial port for esptool (e.g. /dev/ttyACM0)")
    parser.add_argument("--file", type=Path, help="use a local firmware artefact instead of downloading")
    parser.add_argument(
        "--release",
        default="latest",
        help="GitHub release tag to download from (default: latest, falls back to v0.1.0)",
    )
    parser.add_argument(
        "--base-url",
        help="override the release base URL (a local directory works: file:///path or /path)",
    )
    parser.add_argument("--sha256", help="expected sha256 for --file / --base-url artefacts")
    parser.add_argument("--erase", action="store_true", help="erase the whole flash first (ESP32 only)")
    parser.add_argument("--dry-run", action="store_true", help="print the plan without flashing")
    parser.add_argument("--yes", "-y", action="store_true", help="skip the confirmation prompt")
    parser.add_argument("--verbose", "-v", action="store_true")
    return parser.parse_args(argv)


def main(argv: Optional[List[str]] = None) -> int:
    args = parse_args(argv)
    try:
        if args.list or args.list_json:
            list_boards(as_json=args.list_json)
            return 0
        if not args.board:
            raise FlashError("no board given. Try `openmesh-flash --list` or --board auto.", 2)
        board = resolve_board(args.board)
        print(f"Board: {board.name} ({board.key}) — {board.role}")
        print(f"Flash method: {'UF2 mass-storage copy' if board.flash == 'uf2' else 'esptool over USB'}")
        image, expected = resolve_artifact(board, args.release, args.base_url, args.file)
        actual = sha256_of(image)
        if args.sha256 and actual.lower() != args.sha256.lower():
            raise FlashError(
                f"sha256 mismatch for {image}\n  expected {args.sha256}\n  actual   {actual}", 4
            )
        print(f"Image: {image}")
        print(f"sha256: {actual}")
        if not args.dry_run and not args.yes:
            answer = input("Write this firmware to the board? [y/N] ").strip().lower()
            if answer not in ("y", "yes"):
                print("Aborted.")
                return 1
        if board.flash == "uf2":
            flash_uf2(board, image, args.dry_run)
        else:
            flash_esptool(board, image, args.port, args.dry_run, args.erase)
        if args.dry_run:
            print("\nDry run complete; nothing was written.")
        else:
            print("\nDone. See docs/hardware/boards.md for first-boot and companion setup.")
        return 0
    except FlashError as exc:
        print(f"\nopenmesh-flash: {exc}", file=sys.stderr)
        return exc.exit_code
    except KeyboardInterrupt:
        print("\nInterrupted.", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main())
